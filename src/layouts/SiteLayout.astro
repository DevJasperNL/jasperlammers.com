---
import BaseLayout from './BaseLayout.astro';
import { footerLinks, nav, siteName } from '../data/site';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** The nav item to mark as the current section. */
  current?: string;
}

const { current, ...head } = Astro.props;
---

<BaseLayout {...head}>
  <a
    href="#content"
    class="sr-only font-ui font-semibold focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-paper"
  >
    Skip to content
  </a>
  <div class="font-ui">
    <header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-6 md:px-12">
      <a href="/" class="text-lg font-bold tracking-tight whitespace-nowrap">{siteName}</a>
      <nav aria-label="Main">
        <ul class="flex gap-4 text-[0.95rem] font-semibold sm:gap-7">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.href === current ? 'page' : undefined}
                  class="text-muted decoration-accent decoration-2 underline-offset-[6px] hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="mx-auto mt-24 max-w-5xl px-5 pb-10 md:px-12">
      <div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-rule pt-6 text-sm text-muted">
        <span>© {siteName}</span>
        {footerLinks.map((l) => <a href={l.href} class="hover:text-accent">{l.label}</a>)}
      </div>
    </footer>
  </div>
</BaseLayout>
