---
import { getCollection } from 'astro:content';
import { COMPONENTS } from '../../../../components/directions/registry';
import { DIRECTIONS } from '../../../../components/directions/directions';
import { getSeries, type Essay } from '../../../../lib/essays';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return DIRECTIONS.flatMap((direction) =>
    essays.map((essay) => ({ params: { dir: direction.id, slug: essay.data.slug }, props: { direction, essay } })),
  );
}

interface Props {
  direction: (typeof DIRECTIONS)[number];
  essay: Essay;
}

const { direction, essay } = Astro.props;
const { Layout, Essay: EssayView } = COMPONENTS[direction.id];
const series = await getSeries(essay);
---

<Layout
  title={`${essay.data.title}, direction ${direction.id.toUpperCase()} | Jasper Lammers`}
  description={`Design direction ${direction.name}: essay sample.`}
  current="/essays/"
>
  <EssayView essay={essay} series={series} />
</Layout>
