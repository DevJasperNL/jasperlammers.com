---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EssayIndex from '../../components/EssayIndex.astro';
import { essaysPage } from '../../data/site';
---

<SiteLayout title={essaysPage.title} description={essaysPage.description} current="/essays/">
  <div class="mx-auto max-w-3xl px-5 pt-6 md:px-12 md:pt-12">
    <PageIntro heading={essaysPage.heading} intro={essaysPage.intro} />
    <EssayIndex />
  </div>
</SiteLayout>
