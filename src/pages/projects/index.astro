---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { projectsPage } from '../../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout title={projectsPage.title} description={projectsPage.description} current="/projects/">
  <div class="mx-auto max-w-3xl px-5 pt-6 md:px-12 md:pt-12">
    <PageIntro heading={projectsPage.heading} intro={projectsPage.intro} />
    <ol class="mt-12 space-y-3">
      {
        projects.map((p) => (
          <li class="rounded-2xl bg-tint/60 px-5 py-4">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <a
                href={`/projects/${p.id}/`}
                class="text-xl font-bold text-ink decoration-accent decoration-2 underline-offset-4 hover:underline"
              >
                {p.data.title}
              </a>
              <span class="shrink-0 text-sm font-semibold text-accent tabular-nums">{p.data.years}</span>
            </div>
            <p class="mt-1 font-reading text-[1.0625rem] leading-snug text-muted">{p.data.summary}</p>
          </li>
        ))
      }
    </ol>
  </div>
</SiteLayout>
