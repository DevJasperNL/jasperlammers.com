---
import { getImage } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeIntro from '../components/HomeIntro.astro';
import jasper from '../assets/jasper.jpg';
import { footerLinks, home } from '../data/site';

const photo = await getImage({ src: jasper, width: 640, format: 'jpg' });
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jasper Lammers',
  url: Astro.site!.href,
  image: new URL(photo.src, Astro.site).href,
  sameAs: [home.hiring.href, ...footerLinks.map((l) => l.href)],
};
---

<SiteLayout title={home.title} description={home.description} jsonLd={person}>
  <HomeIntro />
</SiteLayout>
