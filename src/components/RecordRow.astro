---
import type { RecordItem } from '../lib/record';

interface Props {
  item: RecordItem;
}

const { item } = Astro.props;
---

<li class="rounded-2xl bg-tint/60 px-5 py-4">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    {
      item.href ? (
        <a href={item.href} class="font-semibold text-ink decoration-accent decoration-2 underline-offset-4 hover:underline">
          {item.title}
        </a>
      ) : (
        <span class="font-semibold">{item.title}</span>
      )
    }
    <span class="shrink-0 text-sm font-semibold text-accent tabular-nums">{item.date}</span>
  </div>
  <p class="mt-1 font-reading text-[1.0625rem] leading-snug text-muted">
    {item.sentence}{
      item.sentenceLink && (
        <>
          <a href={item.sentenceLink.href} class="text-accent underline decoration-1 underline-offset-3 hover:decoration-2">
            {item.sentenceLink.text}
          </a>
          {item.sentenceLink.after}
        </>
      )
    }
    {item.stars && <span class="ml-1 font-ui text-sm font-semibold whitespace-nowrap text-ink">★ {item.stars}</span>}
  </p>
</li>
