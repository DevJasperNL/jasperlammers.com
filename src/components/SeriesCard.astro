---
import type { Series } from '../lib/essays';

interface Props {
  series: Series;
}

const { series } = Astro.props;
---

<nav aria-labelledby="series-heading" class="mt-16 rounded-[1.75rem] bg-tint px-6 py-6 font-ui md:px-8">
  <h2 id="series-heading" class="font-bold">{series.name}</h2>
  <ol class="mt-3 list-decimal space-y-1.5 pl-5 marker:text-muted">
    {
      series.parts.map((p) => (
        <li>
          {p.current ? (
            <span aria-current="page" class="font-semibold">
              {p.label} <span class="font-normal text-muted">← you are here</span>
            </span>
          ) : (
            <a href={`/essays/${p.slug}/`} class="text-accent underline-offset-4 hover:underline">
              {p.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
  {
    series.oneEssay && (
      <p class="mt-4 text-[0.95rem] text-muted">
        Also available as one essay:{' '}
        <a href={`/essays/${series.oneEssay.slug}/`} class="font-semibold text-accent underline underline-offset-4">
          {series.oneEssay.title}
        </a>
        .
      </p>
    )
  }
</nav>
