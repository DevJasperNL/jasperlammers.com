---
import { Picture } from 'astro:assets';
import jasper from '../assets/jasper.jpg';
import { home, nav } from '../data/site';
---

<section class="mx-auto grid max-w-5xl items-center gap-12 px-5 pt-8 md:grid-cols-[1.35fr_1fr] md:gap-16 md:px-12 md:pt-16">
  <div>
    <h1 class="rise text-5xl font-extrabold tracking-tight md:text-6xl" style="--i:0">{home.greeting}</h1>
    <p class="rise mt-6 font-reading text-xl leading-relaxed md:text-[1.375rem]" style="--i:1">{home.intro}</p>
    <p
      class="rise mt-7 inline-flex flex-wrap items-center gap-x-2 rounded-2xl bg-tint px-5 py-2.5 font-semibold sm:rounded-full"
      style="--i:2"
    >
      {home.hiring.text}
      <a href={home.hiring.href} class="text-accent underline decoration-2 underline-offset-4 hover:no-underline">
        → {home.hiring.linkText}
      </a>
    </p>
    <p class="rise mt-7 font-reading text-lg leading-relaxed text-muted" style="--i:3">{home.offClock}</p>
    <ul class="rise mt-9 flex flex-wrap gap-3" style="--i:4">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-block rounded-full border-2 border-accent px-5 py-2 font-bold text-accent transition-colors hover:bg-accent hover:text-paper"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="rise relative mx-auto w-full max-w-[19rem] md:max-w-none" style="--i:3">
    <div aria-hidden="true" class="absolute inset-0 translate-x-4 translate-y-4 rounded-t-full bg-tint md:translate-x-5 md:translate-y-5"></div>
    <Picture
      src={jasper}
      alt={home.photoAlt}
      width={640}
      height={800}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 768px) 360px, 19rem"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="relative aspect-[4/5] w-full rounded-t-full object-cover"
    />
  </div>
</section>
