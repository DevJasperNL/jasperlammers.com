---
// Temporary navigation between the design direction samples. Deliberately neutral, not part of any direction.
import { DIRECTIONS, type DirectionId } from './directions';

interface Props {
  dir: DirectionId;
}

const { dir } = Astro.props;
const path = Astro.url.pathname;
const pages = [
  { label: 'Home', href: `/directions/${dir}/` },
  { label: 'Essay', href: `/directions/${dir}/essays/existence-part-3/` },
  { label: 'Long essay', href: `/directions/${dir}/essays/conscious-deterministic-simulation/` },
  { label: 'Record', href: `/directions/${dir}/record/` },
];
const sibling = (id: DirectionId) => path.replace(`/directions/${dir}/`, `/directions/${id}/`);
---

<nav
  aria-label="Design directions"
  class="bg-neutral-900 px-4 py-2 font-[system-ui] text-[13px] text-neutral-300 [&_a]:underline-offset-2 hover:[&_a]:text-white"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-5 gap-y-1">
    <a href="/directions/" class="font-semibold text-white">Directions</a>
    <span class="flex gap-3">
      {
        pages.map((p) => (
          <a href={p.href} aria-current={p.href === path ? 'page' : undefined} class="aria-[current=page]:text-white aria-[current=page]:underline">
            {p.label}
          </a>
        ))
      }
    </span>
    <span class="flex gap-3 sm:ml-auto">
      {
        DIRECTIONS.map((d) => (
          <a href={sibling(d.id)} aria-current={d.id === dir ? 'true' : undefined} class="aria-[current=true]:text-white aria-[current=true]:underline">
            {d.id.toUpperCase()} {d.name}
          </a>
        ))
      }
    </span>
  </div>
</nav>
