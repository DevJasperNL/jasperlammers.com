---
import '@fontsource-variable/public-sans';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../../../styles/directions/c.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DirectionsBar from '../DirectionsBar.astro';
import { sampleHref } from '../directions';
import { footerLinks, nav } from '../../../data/site';

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current } = Astro.props;
---

<BaseLayout title={title} description={description} direction="c">
  <DirectionsBar dir="c" />
  <a href="#content" class="sr-only font-ui text-sm font-semibold focus:not-sr-only focus:absolute focus:left-4 focus:top-12 focus:bg-accent focus:px-3 focus:py-2 focus:text-paper">
    Skip to content
  </a>
  <div class="border-t-4 border-accent font-ui">
    <header class="mx-auto grid max-w-6xl gap-y-2 px-5 py-6 md:px-10 lg:grid-cols-[12.5rem_1fr] lg:gap-x-10">
      <a href={sampleHref('c', '/')} class="font-bold tracking-tight">Jasper Lammers</a>
      <nav aria-label="Main">
        <ul class="flex gap-6 text-[0.95rem]">
          {
            nav.map((item) => (
              <li>
                <a
                  href={sampleHref('c', item.href)}
                  aria-current={item.href === current ? 'page' : undefined}
                  class="text-muted underline-offset-[6px] hover:text-accent aria-[current=page]:font-semibold aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="mx-auto mt-24 grid max-w-6xl px-5 pb-10 md:px-10 lg:grid-cols-[12.5rem_1fr] lg:gap-x-10">
      <div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-rule pt-5 text-sm text-muted lg:col-start-2 lg:max-w-[38rem]">
        <span>© Jasper Lammers</span>
        {footerLinks.map((l) => <a href={l.href} class="hover:text-accent">{l.label}</a>)}
      </div>
    </footer>
  </div>
</BaseLayout>
