---
import '@fontsource-variable/figtree';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../../../styles/directions/a.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DirectionsBar from '../DirectionsBar.astro';
import { sampleHref } from '../directions';
import { footerLinks, nav } from '../../../data/site';

interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current } = Astro.props;
---

<BaseLayout title={title} description={description} direction="a">
  <DirectionsBar dir="a" />
  <a href="#content" class="sr-only font-ui font-semibold focus:not-sr-only focus:absolute focus:left-4 focus:top-12 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-paper">
    Skip to content
  </a>
  <div class="font-ui">
    <header class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-6 md:px-12">
      <a href={sampleHref('a', '/')} class="text-lg font-bold tracking-tight whitespace-nowrap">Jasper Lammers</a>
      <nav aria-label="Main">
        <ul class="flex gap-4 text-[0.95rem] font-semibold sm:gap-7">
          {
            nav.map((item) => (
              <li>
                <a
                  href={sampleHref('a', item.href)}
                  aria-current={item.href === current ? 'page' : undefined}
                  class="text-muted decoration-accent decoration-2 underline-offset-[6px] hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="mx-auto mt-24 max-w-5xl px-5 pb-10 md:px-12">
      <div class="flex flex-wrap gap-x-6 gap-y-2 border-t border-rule pt-6 text-sm text-muted">
        <span>© Jasper Lammers</span>
        {footerLinks.map((l) => <a href={l.href} class="hover:text-accent">{l.label}</a>)}
      </div>
    </footer>
  </div>
</BaseLayout>
