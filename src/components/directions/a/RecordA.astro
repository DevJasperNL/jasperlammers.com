---
import type { RecordGroup } from '../../../lib/record';
import { recordIntro } from '../../../data/site';
import { sampleHref } from '../directions';

interface Props {
  groups: RecordGroup[];
}

const { groups } = Astro.props;
const href = (h?: string) => (h?.startsWith('/') ? sampleHref('a', h) : h);
---

<div class="mx-auto max-w-3xl px-5 pt-6 md:px-12 md:pt-12">
  <h1 class="text-5xl font-extrabold tracking-tight">Record</h1>
  <p class="mt-5 max-w-[36rem] font-reading text-xl leading-relaxed">{recordIntro}</p>
  {
    groups.map((g) => (
      <section class="mt-14">
        <h2 class="text-2xl font-bold">{g.heading}</h2>
        <ul class="mt-5 space-y-3">
          {g.items.map((item) => (
            <li class="rounded-2xl bg-tint/60 px-5 py-4">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <a href={href(item.href)} class="font-semibold text-ink decoration-accent decoration-2 underline-offset-4 hover:underline">
                  {item.title}
                </a>
                <span class="shrink-0 text-sm font-semibold text-accent tabular-nums">{item.date}</span>
              </div>
              <p class="mt-1 font-reading text-[1.0625rem] leading-snug text-muted">
                {item.sentence}
                {item.stars && <span class="ml-1 whitespace-nowrap font-ui text-sm font-semibold text-ink">★ {item.stars}</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
