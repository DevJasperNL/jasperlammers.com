---
import type { RecordGroup } from '../../../lib/record';
import { recordIntro } from '../../../data/site';
import { sampleHref } from '../directions';

interface Props {
  groups: RecordGroup[];
}

const { groups } = Astro.props;
const href = (h?: string) => (h?.startsWith('/') ? sampleHref('b', h) : h);
---

<div class="mx-auto max-w-[34rem] px-5 pt-8 md:pt-14">
  <h1 class="text-center font-display text-5xl md:text-6xl">Record</h1>
  <p class="mt-5 text-center font-reading text-[1.2rem] leading-relaxed text-muted italic">{recordIntro}</p>
  {
    groups.map((g) => (
      <section class="mt-14">
        <h2 class="border-b border-rule pb-2 text-center font-ui text-xs font-semibold tracking-[0.14em] text-muted uppercase">
          {g.heading}
        </h2>
        <ul class="mt-2">
          {g.items.map((item) => (
            <li class="border-b border-rule/70 py-4 font-reading">
              <p class="flex items-baseline gap-3">
                <a href={href(item.href)} class="text-[1.2rem] leading-snug hover:text-accent hover:underline hover:underline-offset-4">
                  {item.title}
                </a>
                <span aria-hidden="true" class="min-w-4 flex-1 translate-y-[-0.3em] border-b border-dotted border-muted/50" />
                <span class="shrink-0 text-[1.0625rem] text-muted italic tabular-nums">{item.date}</span>
              </p>
              <p class="mt-1 text-[1.0625rem] leading-snug text-muted">
                {item.sentence}
                {item.stars && <span class="ml-1 whitespace-nowrap font-ui text-sm">★ {item.stars}</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
