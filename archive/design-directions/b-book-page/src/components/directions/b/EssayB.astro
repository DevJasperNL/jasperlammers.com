---
import { render } from 'astro:content';
import { breakable, formatDate, splitTitle, type Essay, type Series } from '../../../lib/essays';
import { sampleHref } from '../directions';

interface Props {
  essay: Essay;
  series?: Series;
}

const { essay, series } = Astro.props;
const { Content } = await render(essay);
const { main, subtitle } = splitTitle(breakable(essay.data.title));
---

<article class="mx-auto max-w-[34rem] px-5 pt-8 md:pt-14">
  <header class="text-center">
    <h1 class="break-words font-display text-[2.5rem] leading-[1.1] text-balance md:text-[3.25rem]">
      {main}
      {
        subtitle && (
          <span class="mt-3 block text-[1.5rem] leading-snug text-muted italic md:text-[1.75rem]">
            <span class="sr-only"> - </span>
            {subtitle}
          </span>
        )
      }
    </h1>
    <p class="mt-6 font-reading text-[1.0625rem] text-muted italic">
      First published {formatDate(essay.data.firstPublished)} on{' '}
      <a href={essay.data.waybackUrl} class="text-accent underline decoration-1 underline-offset-4 hover:decoration-2">openminddough.com</a>
    </p>
    <div aria-hidden="true" class="mx-auto mt-8 h-px w-10 bg-accent"></div>
  </header>
  <div class="prose-b mt-10">
    <Content />
  </div>
  {
    series && (
      <nav aria-labelledby="series-b" class="mt-16 border-t border-rule pt-8 text-center">
        <h2 id="series-b" class="font-ui text-xs font-semibold tracking-[0.14em] text-muted uppercase">
          {series.name}
        </h2>
        <ol class="mt-4 space-y-1 font-reading text-lg">
          {series.parts.map((p, i) => (
            <li>
              <span class="mr-1 text-muted">{i + 1}.</span>
              {p.current ? (
                <span aria-current="page" class="italic">
                  {p.label} <span class="text-muted">← you are here</span>
                </span>
              ) : (
                <a href={sampleHref('b', `/essays/${p.slug}/`)} class="text-accent underline-offset-4 hover:underline">
                  {p.label}
                </a>
              )}
            </li>
          ))}
        </ol>
        {series.oneEssay && (
          <p class="mt-5 font-reading text-[1.0625rem] text-muted italic">
            Also available as one essay:{' '}
            <a href={sampleHref('b', `/essays/${series.oneEssay.slug}/`)} class="text-accent underline underline-offset-4">
              {series.oneEssay.title}
            </a>
            .
          </p>
        )}
      </nav>
    )
  }
  <p class="mt-12 text-center font-ui text-xs tracking-[0.14em] uppercase">
    <a href={sampleHref('b', '/essays/')} class="text-muted hover:text-accent">← All essays</a>
  </p>
</article>
