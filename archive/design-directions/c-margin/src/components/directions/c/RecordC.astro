---
import type { RecordGroup } from '../../../lib/record';
import { recordIntro } from '../../../data/site';
import { sampleHref } from '../directions';

interface Props {
  groups: RecordGroup[];
}

const { groups } = Astro.props;
const href = (h?: string) => (h?.startsWith('/') ? sampleHref('c', h) : h);
---

<div class="mx-auto max-w-6xl px-5 pt-6 md:px-10 md:pt-12">
  <div class="lg:grid lg:grid-cols-[12.5rem_1fr] lg:gap-x-10">
    <div class="lg:col-start-2 lg:max-w-[38rem]">
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Record</h1>
      <p class="mt-5 font-reading text-xl leading-relaxed">{recordIntro}</p>
    </div>
  </div>
  {
    groups.map((g) => (
      <section class="mt-14 lg:grid lg:grid-cols-[12.5rem_1fr] lg:gap-x-10">
        <h2 class="border-b border-ink pb-2 text-sm font-semibold tracking-wide uppercase lg:border-0 lg:pt-4 lg:text-right">
          {g.heading}
        </h2>
        <ul class="lg:max-w-[46rem] lg:border-t lg:border-ink">
          {g.items.map((item) => (
            <li class="grid grid-cols-[1fr_auto] gap-x-6 border-b border-rule py-3.5">
              <a href={href(item.href)} class="font-semibold leading-snug decoration-accent decoration-2 underline-offset-4 hover:underline">
                {item.title}
              </a>
              <span class="row-span-2 text-right text-sm text-muted tabular-nums">{item.date}</span>
              <p class="mt-1 font-reading text-[1.0rem] leading-snug text-muted">
                {item.sentence}
                {item.stars && <span class="ml-1 whitespace-nowrap font-ui text-sm font-semibold text-accent">★ {item.stars}</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
