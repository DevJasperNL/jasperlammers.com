---
import { Picture } from 'astro:assets';
import jasper from '../../../assets/jasper.png';
import { sampleHref } from '../directions';
import { home, nav } from '../../../data/site';
---

<section class="mx-auto grid max-w-6xl gap-y-8 px-5 pt-6 md:px-10 md:pt-14 lg:grid-cols-[12.5rem_1fr] lg:gap-x-10">
  <div>
    <Picture
      src={jasper}
      alt="Jasper Lammers, smiling, in front of green leaves"
      width={400}
      widths={[160, 320, 400]}
      sizes="(min-width: 1024px) 200px, 6rem"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="aspect-square w-24 rounded-sm object-cover object-[50%_25%] lg:w-full"
    />
  </div>
  <div class="max-w-[38rem]">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{home.greeting}</h1>
    <p class="mt-6 font-reading text-xl leading-relaxed">{home.intro}</p>
    <p class="mt-8 flex flex-wrap items-baseline gap-x-3 border-y border-rule py-3 text-[1.05rem]">
      <span class="font-semibold">{home.hiring.text}</span>
      <a href={home.hiring.href} class="font-semibold text-accent underline decoration-2 underline-offset-4 hover:no-underline">
        → {home.hiring.linkText}
      </a>
    </p>
    <p class="mt-8 font-reading text-lg leading-relaxed text-muted">{home.offClock}</p>
    <ul class="mt-10 divide-y divide-rule border-y border-rule">
      {
        nav.map((item) => (
          <li>
            <a href={sampleHref('c', item.href)} class="group flex items-center justify-between py-3 text-lg font-semibold hover:text-accent">
              {item.label}
              <span aria-hidden="true" class="text-accent transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
