---
import { render } from 'astro:content';
import { breakable, formatDate, splitTitle, type Essay, type Series } from '../../../lib/essays';
import { sampleHref } from '../directions';

interface Props {
  essay: Essay;
  series?: Series;
}

const { essay, series } = Astro.props;
const { Content } = await render(essay);
const { main, subtitle } = splitTitle(breakable(essay.data.title));
const year = essay.data.firstPublished.slice(0, 4);
---

<article class="mx-auto grid max-w-6xl px-5 pt-6 md:px-10 md:pt-12 lg:grid-cols-[12.5rem_38rem] lg:gap-x-10">
  <div class="mb-6 flex items-baseline justify-between text-sm lg:mb-0 lg:block lg:pt-2 lg:text-right">
    <a href={sampleHref('c', '/essays/')} class="font-semibold text-muted hover:text-accent">← All essays</a>
    <p aria-hidden="true" class="font-semibold text-muted tabular-nums lg:mt-6 lg:text-4xl lg:font-light lg:tracking-tight">{year}</p>
  </div>
  <div class="min-w-0">
    <h1 class="break-words text-[2.125rem] leading-[1.12] font-bold tracking-tight md:text-[2.75rem]">
      {main}
      {
        subtitle && (
          <span class="mt-2 block text-[1.375rem] leading-snug font-normal text-muted md:text-[1.625rem]">
            <span class="sr-only"> - </span>
            {subtitle}
          </span>
        )
      }
    </h1>
    <p class="mt-4 text-[0.95rem] text-muted">
      First published {formatDate(essay.data.firstPublished)} on{' '}
      <a href={essay.data.waybackUrl} class="font-semibold text-accent underline decoration-1 underline-offset-4 hover:decoration-2">openminddough.com</a>
    </p>
    <div class="prose-c mt-10 border-t border-rule pt-10">
      <Content />
    </div>
  </div>
  {
    series && (
      <nav aria-labelledby="series-c" class="mt-16 grid border-t border-rule pt-6 lg:col-span-2 lg:grid-cols-[12.5rem_38rem] lg:gap-x-10">
        <h2 id="series-c" class="text-sm font-semibold text-muted lg:text-right">
          {series.name}
        </h2>
        <div>
          <ol class="mt-3 space-y-1 lg:mt-0">
            {series.parts.map((p, i) => (
              <li class="flex gap-3">
                <span class="w-4 shrink-0 text-right text-muted tabular-nums">{i + 1}</span>
                {p.current ? (
                  <span aria-current="page" class="font-semibold">
                    {p.label} <span class="font-normal text-muted">← you are here</span>
                  </span>
                ) : (
                  <a href={sampleHref('c', `/essays/${p.slug}/`)} class="text-accent underline-offset-4 hover:underline">
                    {p.label}
                  </a>
                )}
              </li>
            ))}
          </ol>
          {series.oneEssay && (
            <p class="mt-4 text-[0.95rem] text-muted">
              Also available as one essay:{' '}
              <a href={sampleHref('c', `/essays/${series.oneEssay.slug}/`)} class="font-semibold text-accent underline underline-offset-4">
                {series.oneEssay.title}
              </a>
              .
            </p>
          )}
        </div>
      </nav>
    )
  }
</article>
